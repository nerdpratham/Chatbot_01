# Copy to .env and fill in.

# Groq API key from https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=openai/gpt-oss-120b

# Port for the API (default: 4000; the client dev proxy expects 4000)
# PORT=4000

# Only when the frontend is hosted on a different domain, comma-separated:
# CLIENT_ORIGIN=https://chat.example.com
